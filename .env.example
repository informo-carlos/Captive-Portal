# ─────────────────────────────────────────
# Banco de dados
# ─────────────────────────────────────────
POSTGRES_USER=captive
POSTGRES_PASSWORD=troque-esta-senha

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=troque-esta-senha-redis

# ─────────────────────────────────────────
# Admin
# ─────────────────────────────────────────
# Gerar com: openssl rand -base64 64
JWT_SECRET=gere-com-openssl-rand-base64-64
# Gerar com: openssl rand -base64 32
ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
ADMIN_API_URL=http://SEU-IP-OU-DOMINIO:8000

# ─────────────────────────────────────────
# Tenant: cliente exemplo (porta 29000)
# Copiar este bloco para cada novo tenant
# Prefixo: TENANT_{NOME}_
# ─────────────────────────────────────────
TENANT_EXEMPLO_ID=uuid-gerado-pelo-banco-ao-criar-o-tenant
TENANT_EXEMPLO_SERIALS=SN-SERIAL1,SN-SERIAL2
TENANT_EXEMPLO_ZENVIA_TOKEN=token-zenvia-do-cliente
TENANT_EXEMPLO_ZENVIA_SENDER=zenvia
TENANT_EXEMPLO_SW_HOST=192.168.1.1
TENANT_EXEMPLO_SW_USER=admin
TENANT_EXEMPLO_SW_PASS=senha-sonicwall
TENANT_EXEMPLO_SW_FIRMWARE=7
TENANT_EXEMPLO_SW_MODE=rest
TENANT_EXEMPLO_SW_LHM_PORT=4043
TENANT_EXEMPLO_SW_GUEST_SERVICE_USER=
TENANT_EXEMPLO_SW_GUEST_SERVICE_PASS=
